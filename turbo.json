{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      // Les NEXT_PUBLIC_* sont figées DANS le bundle au moment du build. Sans cette
      // déclaration, elles ne comptent pas dans la clé de cache : changer une URL de
      // domaine sur Vercel restituerait le build précédent, avec l'ancienne adresse
      // embarquée, et le déploiement s'afficherait en succès.
      // Toute nouvelle NEXT_PUBLIC_* doit être ajoutée ici.
      "env": [
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY",
        "NEXT_PUBLIC_CLIENT_URL",
        "NEXT_PUBLIC_HUB_URL",
        "NEXT_PUBLIC_SITE_URL",
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_AUTH_SESSION_COOKIES",
        "NEXT_PUBLIC_ENABLE_LAB_MODULE",
        "NEXT_PUBLIC_ENABLE_AGENTS",
        "NEXT_PUBLIC_BMAD_BASE_PATH"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test:rls": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test:contracts": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false
    },
    "gen:types": {
      "cache": false
    },
    "clean": {
      "cache": false
    }
  }
}
